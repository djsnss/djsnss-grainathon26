PORT=5000
NODE_ENV=development

# ─── ONE spreadsheet ID that has 4 tabs inside ───
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ─── Tab names inside that spreadsheet ───
GOOGLE_SHEET_DAY1_NAME=Day 1
GOOGLE_SHEET_DAY2_NAME=Day 2
GOOGLE_SHEET_DAY3_NAME=Day 3
GOOGLE_SHEET_COMMITTEE_NAME=Committee

# ─── Column range to read ───
GOOGLE_SHEET_RANGE=A:Z

# ─── Service account ───
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# ─── Rate limit ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100